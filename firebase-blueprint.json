{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated player account profile and career cricket auction stats.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 120
        },
        "favoriteFranchiseId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 5,
          "pattern": "^[A-Z]{2,4}$"
        },
        "careerWins": {
          "type": "integer"
        },
        "careerMatches": {
          "type": "integer"
        },
        "careerPurse": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "favoriteFranchiseId",
        "careerWins",
        "careerMatches",
        "careerPurse",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public non-PII global career ranking entry ranked by accumulated career wins.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "favoriteFranchiseId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 5,
          "pattern": "^[A-Z]{2,4}$"
        },
        "careerWins": {
          "type": "integer"
        },
        "careerMatches": {
          "type": "integer"
        },
        "careerPurse": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "favoriteFranchiseId",
        "careerWins",
        "careerMatches",
        "careerPurse",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Owner-isolated player account profile containing PII (email) and career auction stats."
    },
    "/leaderboard/{userId}": {
      "schema": {
        "$ref": "#/entities/LeaderboardEntry"
      },
      "description": "Public non-PII career wins ranking collection queried to display top players and global rank."
    }
  }
}
