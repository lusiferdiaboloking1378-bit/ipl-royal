rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'favoriteFranchiseId',
          'careerWins',
          'careerMatches',
          'careerPurse',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'favoriteFranchiseId',
          'careerWins',
          'careerMatches',
          'careerPurse',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && data.favoriteFranchiseId is string
        && data.favoriteFranchiseId.size() >= 2
        && data.favoriteFranchiseId.size() <= 5
        && data.favoriteFranchiseId.matches('^[A-Z]{2,4}$')
        && data.careerWins is int
        && data.careerWins >= 0
        && data.careerWins <= 100000
        && data.careerMatches is int
        && data.careerMatches >= data.careerWins
        && data.careerMatches <= 100000
        && data.careerPurse is number
        && data.careerPurse >= 0
        && data.careerPurse <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLeaderboardEntry(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'favoriteFranchiseId',
          'careerWins',
          'careerMatches',
          'careerPurse',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'favoriteFranchiseId',
          'careerWins',
          'careerMatches',
          'careerPurse',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && data.favoriteFranchiseId is string
        && data.favoriteFranchiseId.size() >= 2
        && data.favoriteFranchiseId.size() <= 5
        && data.favoriteFranchiseId.matches('^[A-Z]{2,4}$')
        && data.careerWins is int
        && data.careerWins >= 0
        && data.careerWins <= 100000
        && data.careerMatches is int
        && data.careerMatches >= data.careerWins
        && data.careerMatches <= 100000
        && data.careerPurse is number
        && data.careerPurse >= 0
        && data.careerPurse <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Private PII user profile (contains email) — strictly owner-only get, no list
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'favoriteFranchiseId',
          'careerWins',
          'careerMatches',
          'careerPurse',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Public non-PII Global Leaderboard (zero email/PII) — signed-in queryable by careerWins
    match /leaderboard/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && existing().careerWins >= 0;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isVerifiedUser()
        && isValidLeaderboardEntry(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isVerifiedUser()
        && isValidLeaderboardEntry(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'favoriteFranchiseId',
          'careerWins',
          'careerMatches',
          'careerPurse',
          'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
